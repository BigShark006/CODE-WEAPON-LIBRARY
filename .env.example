# Supabase Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git

# Your Supabase project URL (found in Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe to expose in frontend)
# Found in Supabase Dashboard > Project Settings > API > Project API keys > anon public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# NOTE: NEVER put service_role key or any secret here
# The service_role key should ONLY be used in server-side code or Supabase Edge Functions
